<mujoco model="anygine modular dual panda frame">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <default class="frame_visual">
      <geom group="2" contype="0" conaffinity="0" rgba="0.24 0.29 0.36 1"/>
    </default>
    <default class="mount_site">
      <site type="sphere" size="0.012" rgba="0.15 0.65 1 0.35" group="4"/>
    </default>
  </default>

  <worldbody>
    <body name="dual_panda_base" pos="0 0 0.34">
      <geom name="dual_panda_base_visual" class="frame_visual" type="box" size="0.22 0.28 0.34"/>
      <geom name="dual_panda_base_column_visual" class="frame_visual" type="cylinder"
        pos="0 0 0.40" size="0.13 0.10" rgba="0.14 0.17 0.22 1"/>

      <body name="dual_panda_torso" pos="0 0 0.57">
        <geom name="dual_panda_torso_visual" class="frame_visual" type="box"
          size="0.16 0.235 0.20"/>

        <body name="dual_panda_shoulder_carrier" pos="0.035 0 0.27">
          <geom name="dual_panda_shoulder_beam_visual" class="frame_visual" type="capsule"
            fromto="0 -0.34 0 0 0.34 0" size="0.085" rgba="0.18 0.22 0.28 1"/>
          <!-- Rotate each table-mounted Panda +90 degrees about Y so its original +Z axis points
               forward. The home pose then hangs naturally below a human-height shoulder line. -->
          <site name="left_shoulder_mount" class="mount_site" pos="0 0.34 0"
            quat="0.7071067811865476 0 0.7071067811865476 0"/>
          <site name="right_shoulder_mount" class="mount_site" pos="0 -0.34 0"
            quat="0.7071067811865476 0 0.7071067811865476 0"/>

          <body name="dual_panda_head" pos="0.035 0 0.30">
            <geom name="dual_panda_neck_visual" class="frame_visual" type="cylinder"
              pos="0 0 -0.15" size="0.055 0.15" rgba="0.12 0.15 0.20 1"/>
            <geom name="dual_panda_head_visual" class="frame_visual" type="box"
              size="0.105 0.13 0.09" rgba="0.30 0.36 0.44 1"/>
            <geom name="dual_panda_sensor_bar_visual" class="frame_visual" type="box"
              pos="0.105 0 0.015" size="0.018 0.105 0.035" rgba="0.06 0.08 0.11 1"/>
            <site name="head_imu_mount" class="mount_site" pos="0.02 0 0"/>
            <camera name="head_rgb" pos="0.11 0 0.015" xyaxes="0 -1 0 0 0 1" fovy="58"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <accelerometer name="head_accelerometer" site="head_imu_mount"/>
    <gyro name="head_gyro" site="head_imu_mount"/>
  </sensor>
</mujoco>
