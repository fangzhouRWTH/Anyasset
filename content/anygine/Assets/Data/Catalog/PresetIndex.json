{
  "schema_version": 1,
  "description": "Logical preset ids for fetched Assets/Data packs. Paths are relative to Assets/Data/.",
  "packs": {
    "menagerie": {
      "label": "MuJoCo Menagerie",
      "kind": "git",
      "url": "https://github.com/google-deepmind/mujoco_menagerie.git",
      "default_ref": "main",
      "recommended_pin": "71f066ad0be9cd271f7ed58c030243ef157af9f4",
      "ref_env": "ANYGINE_MENAGERIE_REF",
      "destination": "Robots/Menagerie",
      "license_note": "Per-model LICENSE files must be retained under each robot folder.",
      "default_select": [
        "unitree_go2",
        "franka_emika_panda",
        "aloha",
        "pal_tiago_dual"
      ],
      "available_select": [
        "unitree_go2",
        "franka_emika_panda",
        "aloha",
        "pal_tiago_dual"
      ]
    },
    "policies": {
      "label": "Robot policy packages",
      "kind": "manual",
      "destination": "Policies",
      "note": "Default: seed schema template. --select go2_velocity_flat downloads matching ONNX weights from Hugging Face.",
      "default_select": "template",
      "available_select": [
        "template",
        "go2_velocity_flat"
      ],
      "weight_sources": {
        "go2_velocity_flat": {
          "kind": "huggingface",
          "repo": "diasAiMaster/unitree-go2-velocity-flat",
          "revision": "main",
          "license": "bsd-3-clause",
          "framework": "unitree_rl_mjlab / RSL-RL",
          "observation_size": 45,
          "action_size": 12,
          "action_scale": 0.5,
          "files": [
            "policy.onnx",
            "policy.onnx.data",
            "params/deploy.yaml"
          ],
          "notes": "Obs layout matches Go2JoystickPolicy (45). Joint order FR/FL/RR/RL; fetch rewrites action.json. Load via policy_worker.py --backend auto + setup-policy-worker.sh."
        }
      }
    },
    "direct_drive": {
      "label": "Direct Drive TITA/TITATIT demo assets",
      "kind": "multi_git",
      "destination": "Robots/DirectDrive",
      "default_select": "tita,titatit",
      "available_select": [
        "tita",
        "titatit"
      ],
      "license_note": "The two training repositories declare MIT. The ddt_ros2_control package metadata leaves the asset/policy license undeclared; customer-commissioned experimental authorization and exact provenance are recorded instead of inferring a repository-wide license.",
      "sources": {
        "tita": {
          "url": "https://github.com/DDTRobot/tita_rl.git",
          "default_ref": "77abbc367a2db3a2036a53e38930e80620e9f915",
          "ref_env": "ANYGINE_TITA_RL_REF",
          "license": "MIT"
        },
        "tita_deployment": {
          "url": "https://github.com/DDTRobot/ddt_ros2_control.git",
          "default_ref": "63e9e6e625357802ea982b99edc62a29de42afe8",
          "ref_env": "ANYGINE_TITA_DEPLOYMENT_REF",
          "license": "upstream-package-license-undeclared; customer-commissioned-experimental-use"
        },
        "titatit_deployment": {
          "url": "https://github.com/DDTRobot/ddt_ros2_control.git",
          "default_ref": "63e9e6e625357802ea982b99edc62a29de42afe8",
          "ref_env": "ANYGINE_TITATIT_DEPLOYMENT_REF",
          "license": "upstream-package-license-undeclared; customer-commissioned-experimental-use"
        },
        "titatit": {
          "url": "https://github.com/DDTRobot/quadruped-wheel-titatit-rl.git",
          "default_ref": "4ba7d2d72b96f2bf64efe793c49497feedf2e6de",
          "ref_env": "ANYGINE_TITATIT_RL_REF",
          "license": "MIT"
        }
      }
    }
  },
  "presets": [
