{
  "_authoring": {
    "description": "RobotDescription v0 sidecar template for an imported glTF rover.",
    "companion_asset": "Place demo_rover.glb in this same folder (filename must match robot.asset).",
    "units": "meters, Z-up, robot forward = +X",
    "expected_gltf_node_tree": [
      "demo_rover",
      "  base_link",
      "    chassis_mesh",
      "  wheel_fl_link",
      "    wheel_fl_mesh",
      "  wheel_fr_link",
      "    wheel_fr_mesh",
      "  wheel_rl_link",
      "    wheel_rl_mesh",
      "  wheel_rr_link",
      "    wheel_rr_mesh",
      "  front_camera_mount"
    ],
    "notes": [
      "Rename glTF nodes to match source_node fields below, or edit source_node to match your export.",
      "Keep collision sizes/radii in this JSON; do not infer them from mesh geometry.",
      "Adjust joint origin xyz and collision box size after measuring the authored model.",
      "Wheel joint axis [0,1,0] means spin about chassis left/right (Y)."
    ]
  },
