{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anyasset assets.toml parsed data model v1/v2",
  "type": "object",
  "required": [
    "schema",
    "source",
    "collections"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "index",
          "collections"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "index": {
            "type": "string",
            "pattern": "^external-indexes/.+\\.json$"
          },
          "collections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "external"
        ],
        "properties": {
          "external": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "schema": {
            "const": 2
          }
        }
      }
    }
  ]
}
