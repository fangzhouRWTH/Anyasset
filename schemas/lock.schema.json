{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anyasset engine lock v1",
  "type": "object",
  "required": ["schema", "source", "commit", "requirements_digest", "collections", "files", "assets"],
  "properties": {
    "schema": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requirements_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "lfs"],
        "properties": {
          "path": {"type": "string", "pattern": "^content/"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "lfs": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "assets": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^content/"}}
  },
  "$comment": "Runtime also verifies requirement digest and resolves commit catalog to check exact records before new snapshot publication."
}
